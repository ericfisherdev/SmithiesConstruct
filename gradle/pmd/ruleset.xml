<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="SmithiesConstruct port-1.21.1"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0
             https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        Lightweight PMD ruleset for the 1.21.1 port. Spotless owns formatting (SMTCON-189);
        this ruleset focuses on correctness and code-smell rules that catch real defects.
        Rules that fight Minecraft modding idioms (capability/registry singletons, Mojang
        mappings, public static event handlers) are excluded.
    </description>

    <rule ref="category/java/bestpractices.xml">
        <exclude name="AvoidReassigningParameters"/>
        <exclude name="GuardLogStatement"/>
        <exclude name="JUnit5TestShouldBePackagePrivate"/>
        <!-- NeoForge event handlers must keep their event parameter even if unused. -->
        <exclude name="UnusedFormalParameter"/>
        <exclude name="UnusedAssignment"/>
        <!-- Tests routinely verify multiple related facts per method (e.g. Mockito verify() pairs);
             enforcing 1-assert-per-test fragments cohesive scenarios and lowers signal. -->
        <exclude name="UnitTestContainsTooManyAsserts"/>
        <!-- Table-style assertAll(...) tests where each row is a self-documenting comparison
             (e.g. registry-key equality) don't gain readability from forced messages on every
             assertEquals; meaningful messages are added by hand where the failure context is
             non-obvious. -->
        <exclude name="UnitTestAssertionsShouldIncludeMessage"/>
        <!-- Many of our interfaces (e.g. Pulse) intentionally expose one abstract method plus
             several defaults but are *not* meant as lambda targets — they describe a contract
             for named subsystem classes. Marking them @FunctionalInterface would mislead
             readers. Genuine SAM types still tag themselves explicitly (e.g. PulseGate). -->
        <exclude name="ImplicitFunctionalInterface"/>
        <!-- Re-included below with allowedTypes so Minecraft's NBT builder classes
             (ListTag, CompoundTag) can be declared with their concrete type — their add()/put()
             builder methods aren't on the Tag interface. -->
        <exclude name="LooseCoupling"/>
    </rule>

    <!-- LooseCoupling generally good practice, but Minecraft's NBT API requires the concrete
         ListTag / CompoundTag types as local variables: builder methods like .add(Tag) and
         .put(String, Tag) live on the subclasses, not the Tag interface. -->
    <rule ref="category/java/bestpractices.xml/LooseCoupling">
        <properties>
            <property name="allowedTypes"
                      value="net.minecraft.nbt.ListTag,net.minecraft.nbt.CompoundTag"/>
        </properties>
    </rule>

    <rule ref="category/java/errorprone.xml">
        <exclude name="AvoidDuplicateLiterals"/>
        <exclude name="AvoidFieldNameMatchingMethodName"/>
        <exclude name="AvoidFieldNameMatchingTypeName"/>
        <exclude name="MissingSerialVersionUID"/>
        <!-- @GameTest holder classes look like JUnit classes to PMD but use a different framework. -->
        <exclude name="TestClassWithoutTestCases"/>
        <!-- Re-included below with allowCommentedBlocks=true so an explanatory comment in a
             deliberate empty catch satisfies the rule. -->
        <exclude name="EmptyCatchBlock"/>
    </rule>

    <!-- A commented-only catch is the canonical way to mark "I considered this exception and
         chose to absorb it"; bare empty catches are still flagged. -->
    <rule ref="category/java/errorprone.xml/EmptyCatchBlock">
        <properties>
            <property name="allowCommentedBlocks" value="true"/>
        </properties>
    </rule>

    <rule ref="category/java/multithreading.xml">
        <exclude name="UseConcurrentHashMap"/>
        <exclude name="DoNotUseThreads"/>
    </rule>

    <rule ref="category/java/performance.xml">
        <exclude name="AvoidInstantiatingObjectsInLoops"/>
    </rule>

    <rule ref="category/java/security.xml"/>

</ruleset>
